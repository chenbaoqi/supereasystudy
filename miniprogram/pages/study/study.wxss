/* 学习 tab「我的教材」样式（Chapter 14 §4） */
@import '../shared/list.wxss';

.hint {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
}

.guide-card {
  margin: 60rpx 30rpx;
  padding: 48rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.guide-title {
  font-size: 34rpx;
  font-weight: 600;
}

.guide-desc {
  color: #999999;
  font-size: 26rpx;
}

.guide-btn {
  margin-top: 16rpx;
  width: 60%;
}

.current-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 30rpx;
  padding: 24rpx 32rpx;
  background: #e8f9f0;
  border-radius: 16rpx;
}

.current-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
}

.switch-tag {
  color: #07c160;
  font-size: 24rpx;
}
