<view class="container">
  <view class="accuracy">{{accuracy}}%</view>
  <view class="label">正确率（{{correct}} / {{total}}）</view>
  <view class="duration">用时 {{durationText}}</view>
  <view class="actions">
    <button type="primary" bindtap="onRestudy">重新学习</button>
    <button bindtap="onGoReview">去复习</button>
    <button bindtap="onBackToChapter">返回章节</button>
  </view>
</view>
