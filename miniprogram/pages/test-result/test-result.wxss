/* 测试结果页样式（§15：UI 从简） */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 24rpx;
}

.accuracy {
  font-size: 96rpx;
  font-weight: 600;
  color: #07c160;
}

.label {
  font-size: 30rpx;
}

.duration {
  color: #999999;
  font-size: 26rpx;
}

.actions {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 60%;
}
