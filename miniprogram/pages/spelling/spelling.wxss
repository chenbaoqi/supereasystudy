/* 拼写练习：一屏一个词，输入框是主角。 */
.sp-progress {
  margin: 0 var(--gutter) var(--sp-3);
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--ink-3);
}

.sp-card {
  margin: 0 var(--gutter) var(--sp-4);
  text-align: center;
}

.sp-meaning {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--ink-1);
}

.sp-hint {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--ink-3);
}

.sp-audio {
  margin-top: var(--sp-3);
}

.sp-input {
  margin: 0 var(--gutter);
  padding: var(--sp-3);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-card);
  background: var(--bg-card);
  font-size: 36rpx;
  text-align: center;
  color: var(--ink-1);
}

.sp-placeholder {
  color: var(--ink-3);
}

.sp-feedback {
  margin: var(--sp-3) var(--gutter) 0;
  text-align: center;
  font-size: var(--fs-md);
}

.sp-ok {
  color: var(--success);
}

.sp-bad {
  color: var(--danger);
}

.sp-next {
  margin: var(--sp-4) var(--gutter) 0;
}

.sp-result {
  padding: var(--sp-8) var(--gutter) 0;
  text-align: center;
}

.sp-result-title {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--ink-1);
}

.sp-result-score {
  margin-top: var(--sp-3);
  font-size: 40rpx;
  color: var(--brand-600);
}

/* 本局学分（+N⭐）：拼对多少是「表现」，这是「得到多少」 */
.sp-result-stars {
  margin-top: var(--sp-2);
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--brand-600);
}

.sp-result-tip {
  margin-top: var(--sp-3);
  font-size: var(--fs-sm);
  color: var(--ink-3);
}

.sp-back {
  margin-top: var(--sp-8);
}

.sp-retry {
  margin-top: var(--sp-3);
}
