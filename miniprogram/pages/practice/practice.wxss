/* 练习 tab 样式（UI v1.1「清爽蓝·淡色版」）
   与学习页共用淡蓝头部与全局组件类，本文件只放头部按钮的微调。 */

.study-book {
  font-size: var(--fs-lg);
  line-height: 1.4;
}

.study-switch {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
  padding: 10rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--bg-card);
  border: 1rpx solid var(--brand-200);
  color: var(--brand-600);
  font-size: var(--fs-sm);
}
