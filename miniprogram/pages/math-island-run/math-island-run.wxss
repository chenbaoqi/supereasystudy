/* 口算冒险岛 · 答题页
   儿童风：大算式 + 大按键；对错只改淡底与描边（连续答题时整块实色最晃眼）。
   色值全部走 token，本页独有样式走 miq- 前缀。 */
.miq-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(var(--sp-6) + env(safe-area-inset-bottom));
}

/* ------------------------------------------------------------- 顶部状态 */
.miq-hud {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--gutter);
}

.miq-hearts {
  flex: 0 0 auto;
  font-size: var(--fs-sm);
}

.miq-meta {
  flex: 1 1 auto;
  min-width: 160rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
}

.miq-stars {
  flex: 0 0 auto;
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--brand-700);
}

.miq-combo {
  flex: 0 0 auto;
  padding: 2rpx var(--sp-2);
  border-radius: var(--r-pill);
  background: var(--warning-bg);
  color: var(--warning);
  font-size: var(--fs-xs);
  font-weight: 700;
}

/* ------------------------------------------------------------- 关卡进度面板 */
.miq-panel {
  margin: 0 var(--gutter) var(--sp-3);
  padding: var(--sp-3);
  background: var(--bg-subtle);
  border-radius: var(--r-md);
}

.miq-line {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
}

/* 数值进度条（火山能量 / 巨龙血量 / 固定题号） */
.miq-track {
  margin-top: var(--sp-2);
  height: 16rpx;
  border-radius: var(--r-pill);
  background: var(--brand-100);
  overflow: hidden;
}

.miq-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--grad-brand);
  transition: width 0.25s;
}

/* 火山能量用暖色（危险感），巨龙血量用绿色 */
.miq-fill.is-volcano {
  background: linear-gradient(90deg, #ffb03a, #ff4d3d);
}

.miq-fill.is-dragon {
  background: linear-gradient(90deg, #7ad48f, #2f9e52);
}

.miq-hint {
  margin-top: var(--sp-1);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-3);
}

/* 森林步数点 */
.miq-dots {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
  gap: 2rpx;
}

.miq-dot {
  font-size: 20rpx;
  line-height: 1;
}

.miq-dot.is-now {
  font-size: 28rpx;
}

/* 独木桥桥板 */
.miq-planks {
  display: flex;
  gap: 4rpx;
  margin-top: var(--sp-2);
}

.miq-plank {
  flex: 1;
  height: 20rpx;
  border-radius: 6rpx;
  background: var(--brand-100);
}

.miq-plank.is-on {
  background: linear-gradient(180deg, #ffd88a, #e6a63c);
}

/* ------------------------------------------------------------- 算式卡 */
.miq-card {
  margin: var(--sp-4) var(--gutter) var(--sp-5);
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--bg-card);
  border: 2rpx solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  text-align: center;
  transition: background 0.15s;
}

.miq-card.is-correct {
  background: var(--success-bg);
  border-color: var(--success);
}

.miq-card.is-wrong,
.miq-card.is-answer {
  background: var(--danger-bg);
  border-color: var(--danger);
}

.miq-q {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--ink-1);
  line-height: 1.3;
}

.miq-input {
  margin-top: var(--sp-3);
  min-height: 64rpx;
  font-size: var(--fs-xl);
  font-weight: 600;
  color: var(--brand-700);
}

/* ------------------------------------------------------------- 数字键盘 */
/* ⚠️ 这里的写法是「被实测逼出来的」，改之前先看注释：
   **微信给 button 内置了 width: 184px，特异性 (0,1,1)**
   （真身是 `button:not([size=mini])` / Skyline 的 `wx-button.wx-button-type-*`）。
   1. 【必需】按键宽度必须用「双类名」提到 (0,2,0) 给 width:100%——
      单类名 .miq-key (0,1,0) 压不过内置规则，不设宽就等于承认它是 184px。
      它一旦是 184px，在 repeat(3, 1fr) 里就成了**每列的最小宽度**，
      3 列 552px 溢出容器，第 3 列（3 / 6 / 9 /「确定」）整列落到屏幕外，
      孩子填完答案点不到确定，关卡死（2026-09-16 按 Owner 截图定位）。
   2. 【加固】列写 minmax(0, 1fr)：单靠这条不够（见下表 C），
      但它能保证以后哪个子元素再带上固定宽度也不会把列撑开。min-width: 0 同理。
   无头浏览器实测（375px 视口 + 照抄内置 button 样式）：
     A 现状 repeat(3,1fr)、按键不设宽  → 列 184/184/184，键 184，溢出 +217px（复现截图）
     B 两条都加（= 当前实现）          → 列 111.7×3，键 112，溢出 0
     C 只加 minmax(0,1fr)             → 列 111.7×3，但键仍 184，溢出 +72px
     D 只给按键 width:100%（双类名）   → 列 111.7×3，键 112，溢出 0 */
.miq-keypad {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sp-3);
  margin: 0 var(--gutter);
}

.miq-keypad .miq-key {
  width: 100%;
  min-width: 0;
}

.miq-key {
  height: 108rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-card);
  color: var(--ink-1);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.miq-key::after {
  border: none;
}

.miq-key.is-del {
  color: var(--ink-2);
  font-size: var(--fs-lg);
}

.miq-key.is-ok {
  background: var(--grad-brand);
  border: none;
  color: #ffffff;
  box-shadow: var(--shadow-brand);
}

.miq-exit {
  margin: var(--sp-4) var(--gutter) 0;
}

/* ------------------------------------------------------------- 作答反馈 */
.miq-fb {
  position: absolute;
  left: 0;
  right: 0;
  top: 300rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.miq-fb-box {
  max-width: 560rpx;
  padding: var(--sp-4) var(--sp-5);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-float);
  background: var(--bg-card);
  text-align: center;
}

.miq-fb.is-correct .miq-fb-box {
  background: var(--success-bg);
}

.miq-fb.is-wrong .miq-fb-box,
.miq-fb.is-answer .miq-fb-box {
  background: var(--danger-bg);
}

.miq-fb-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--ink-1);
}

.miq-fb-sub {
  margin-top: var(--sp-1);
  font-size: var(--fs-base);
  color: var(--ink-2);
}

/* ------------------------------------------------------------- 结算弹层 */
.miq-mask {
  position: fixed;
  inset: 0;
  background: var(--bg-mask);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--gutter);
}

.miq-result {
  width: 100%;
  max-width: 600rpx;
  padding: var(--sp-6) var(--sp-4) var(--sp-4);
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-float);
  text-align: center;
}

.miq-result-env {
  font-size: 96rpx;
  line-height: 1;
}

.miq-result-title {
  margin-top: var(--sp-2);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--ink-1);
}

.miq-result-level {
  font-size: var(--fs-base);
  color: var(--ink-2);
}

.miq-result-gain {
  margin-top: var(--sp-4);
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--brand-700);
}

.miq-result-badge {
  margin-top: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--warning-bg);
  color: var(--warning);
  font-size: var(--fs-sm);
  font-weight: 700;
}

.miq-result-stats {
  margin-top: var(--sp-2);
  font-size: var(--fs-sm);
  color: var(--ink-2);
}

.miq-result-castle {
  margin-top: var(--sp-3);
  font-size: var(--fs-lg);
}

.miq-result-unlock {
  margin-top: var(--sp-3);
  padding: var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--state-done-bg);
  color: var(--state-done);
  font-size: var(--fs-base);
  font-weight: 600;
}

.miq-result-reason {
  margin-top: var(--sp-3);
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--warning);
}

.miq-result-back {
  margin-top: var(--sp-2);
}
