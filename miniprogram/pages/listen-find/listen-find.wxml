<!-- 听音找词（Chapter 08 §16，Owner 2026-07-20 双模式）
     UI v1.1（2026-09-14）：与原 #07c160 实色喇叭不同，改用 u-speaker 的淡蓝底 + 品牌色图标；
     双模式按钮降级第二个为次操作（原来是两颗一模一样的微信绿按钮，看不出主次）。 -->
<view wx:if="{{poolEmpty}}" class="u-empty">
  <view class="u-empty-icon">🎧</view>
  <view class="u-empty-text">本章节知识点不足</view>
  <view class="u-empty-sub">换一个章节或学段再来看看</view>
</view>

<block wx:elif="{{status === 'READY'}}">
  <view class="g-ready">
    <view class="g-title">听音找词</view>
    <view class="g-rules">每题 {{totalSeconds}} 秒 · 答对 +10 · 连击加成 · 答错/超时 -2</view>
    <view class="g-rules">选择一种形式开始</view>
    <view class="g-actions">
      <button class="u-btn u-btn-primary u-btn-block" data-mode="word" bindtap="onStartGame" hover-class="u-tap" hover-stay-time="60">
        听音选词（选英文）
      </button>
      <button class="u-btn u-btn-block" data-mode="meaning" bindtap="onStartGame" hover-class="u-tap" hover-stay-time="60">
        听音选义（选中文）
      </button>
    </view>
  </view>
</block>

<block wx:else>
  <view class="g-page">
    <view class="g-hud">
      <text>第 {{currentIndex + 1}} / {{total}} 题</text>
      <text class="g-hud-score">得分 {{score}}</text>
      <text wx:if="{{streak >= 2}}" class="g-combo">Combo x{{streak}}</text>
    </view>

    <view class="g-timer">
      <view
        class="g-timer-fill {{remaining <= 2 ? 'is-urgent' : ''}}"
        style="width: {{remaining / totalSeconds * 100}}%"
      ></view>
    </view>

    <view class="u-speaker-wrap">
      <button
        class="u-speaker {{speaking ? 'g-speaker-text' : ''}}"
        bindtap="onReplay"
        disabled="{{speaking}}" hover-class="u-tap" hover-stay-time="60"
      >
        {{speaking ? '合成中…' : '🔊'}}
      </button>
      <view class="u-speaker-hint">点击可重复播放</view>
    </view>

    <view class="u-options">
      <button
        wx:for="{{question.options}}"
        wx:key="*this"
        class="u-option {{answered ? (index === question.correctIndex ? 'is-correct' : (index === selected ? 'is-wrong' : '')) : ''}}"
        data-index="{{index}}"
        bindtap="onSelect" hover-class="u-tap-flat" hover-stay-time="60"
      >
        <text class="u-option-text">{{item}}</text>
      </button>
    </view>

    <button class="u-btn u-btn-ghost u-btn-block g-exit" bindtap="onExit" hover-class="u-tap" hover-stay-time="60">退出</button>
  </view>
</block>
