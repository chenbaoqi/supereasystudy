<!-- 首页 Dashboard（UI v1「清爽蓝」）
     区块顺序严格按 Specification §12.5 冻结顺序：
     ① Banner → ② 学习统计条 → ③ 最近学习 → ④ 学科入口（§12.1 纵向列表，非宫格） -->
<view wx:if="{{loading}}" class="u-empty">
  <text class="u-empty-text">加载中…</text>
</view>

<view wx:elif="{{loadFailed}}" class="u-empty">
  <text class="u-empty-icon">📶</text>
  <text class="u-empty-text">加载失败，请检查网络</text>
  <button class="u-btn u-btn-primary u-btn-sm retry-btn" bindtap="onRetry" hover-class="u-tap" hover-stay-time="60">重试</button>
</view>

<block wx:else>
  <!-- ① Banner 轮播（§12.5-1：无数据则隐藏本区块） -->
  <swiper wx:if="{{banners.length > 0}}" class="u-banner" indicator-dots autoplay circular>
    <swiper-item wx:for="{{banners}}" wx:key="_id">
      <image class="u-banner-image" src="{{item.imageUrl}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- ② 学习统计条（§12.5-2：今日复习知识点 / 连续学习天数） -->
  <view class="home-stats">
    <view class="home-hello">{{greeting}}，同学</view>
    <view class="home-sub">{{heroSub}}</view>
    <view class="home-stats-row">
      <view class="home-stat">
        <text class="home-stat-num">{{todayReviewedKnowledge}}</text>
        <text class="home-stat-label">今日复习</text>
      </view>
      <view class="home-stat">
        <text class="home-stat-num">{{streakDays}}</text>
        <text class="home-stat-label">连续学习（天）</text>
      </view>
    </view>
    <button class="u-btn u-btn-block home-cta" bindtap="onTapContinue" hover-class="u-tap" hover-stay-time="60">{{continueText}}</button>
  </view>

  <!-- 教材偏好引导条（Chapter 14 §4：未设置偏好时显示，设置后永久消失） -->
  <view wx:if="{{!hasPreference}}" class="u-tip" bindtap="onTapGuide" hover-class="u-tap" hover-stay-time="60">
    <text class="u-tip-text">📚 还没选教材：选一次版本 / 年级 / 学期，以后直达课程</text>
    <view class="u-arrow"></view>
  </view>

  <!-- ③ 最近学习（§12.5-3：updatedAt 倒序前 3，点击续学） -->
  <view class="u-section">
    <text class="u-section-title">最近学习</text>
  </view>
  <view wx:if="{{recentLearning.length > 0}}" class="u-list">
    <view
      wx:for="{{recentLearning}}"
      wx:key="chapterId"
      class="u-row"
      data-chapter-id="{{item.chapterId}}"
      data-semester-id="{{item.semesterId}}"
      bindtap="onTapRecent" hover-class="u-tap-flat" hover-stay-time="60" hover-stop-propagation
    >
      <view class="u-row-icon">📖</view>
      <view class="u-row-body">
        <view class="u-row-title">{{item.title}}</view>
        <view class="u-row-sub">继续上次进度</view>
      </view>
      <view class="u-row-extra">
        <text class="u-chip u-chip-brand">继续</text>
        <button
          wx:if="{{item.showGame}}"
          class="u-btn u-btn-sm"
          data-chapter-id="{{item.chapterId}}"
          data-semester-id="{{item.semesterId}}"
          catchtap="onTapRecentGame" hover-class="u-tap" hover-stay-time="60"
        >
          🎮 挑战
        </button>
      </view>
    </view>
  </view>
  <view wx:else class="u-card recent-empty">
    <text class="u-empty-sub">还没有学习记录，选一门学科开始吧</text>
  </view>

  <!-- ④ 学科入口（§12.1 冻结：纵向列表） -->
  <view class="u-section">
    <text class="u-section-title">学科</text>
  </view>
  <view class="u-list">
    <view
      wx:for="{{subjectCards}}"
      wx:key="_id"
      class="u-row {{item.open ? '' : 'u-row-locked'}}"
      data-id="{{item._id}}"
      bindtap="onTapSubject" hover-class="u-tap-flat" hover-stay-time="60"
    >
      <view class="u-row-icon u-icon-{{item.theme}}">{{item.icon}}</view>
      <view class="u-row-body">
        <view class="u-row-title">{{item.name}}</view>
        <view class="u-row-sub">{{item.desc}}</view>
      </view>
      <view class="u-row-extra">
        <text wx:if="{{item.open}}" class="u-chip u-chip-brand">进入学习</text>
        <text wx:else class="u-chip u-chip-muted">敬请期待</text>
        <view class="u-arrow"></view>
      </view>
    </view>
  </view>

  <view class="u-safe-bottom"></view>
</block>
