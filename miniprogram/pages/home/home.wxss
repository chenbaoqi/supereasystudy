/* 首页样式（§15 UI 从简；统计卡与复习页同款） */
@import '../shared/list.wxss';

.banner {
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
  height: 280rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.stats {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 30rpx;
  padding: 40rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.num {
  font-size: 44rpx;
  font-weight: 600;
}

.label {
  color: #999999;
  font-size: 24rpx;
}

.section-title {
  margin: 32rpx 30rpx 12rpx;
  font-size: 28rpx;
  color: #666666;
}
