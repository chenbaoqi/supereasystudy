/* 设置页 UI v1.1（2026-09-14）：列表/行/chip/按钮均取自 styles/components.wxss，
   这里只有年级选择器与底部操作区的几个 set- 类（.st- 已被统计页占用，别混）。 */
.set-picker {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin: var(--sp-2) var(--gutter) var(--sp-4);
  padding: var(--sp-4);
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

/* 未选中的年级：中性底（u-chip 默认无底色，这里补一层浅灰） */
.set-chip {
  background: var(--state-todo-bg);
  color: var(--ink-2);
  padding: 10rpx 24rpx;
  font-size: var(--fs-sm);
}

.set-chip-on {
  background: var(--state-doing-bg);
  color: var(--brand-600);
  font-weight: 600;
}

.set-hint {
  margin-top: var(--sp-2);
  font-size: var(--fs-xs);
  color: var(--ink-3);
  line-height: 1.7;
}

/* 自绘开关（原生 switch 是微信绿，跟令牌对不上）：
   胶囊底 + 一个圆点，开 = 品牌色 + 圆点靠右。点的是整行，开关本身不可点。 */
.set-switch {
  flex-shrink: 0;
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--ink-4);
  padding: 4rpx;
  box-sizing: border-box;
  transition: background 160ms ease;
}

.set-switch-on {
  background: var(--brand-500);
}

.set-switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(42, 52, 68, 0.2);
  transition: transform 160ms ease;
}

.set-switch-on .set-switch-dot {
  transform: translateX(36rpx);
}

.set-actions {
  margin: var(--sp-6) var(--gutter) 0;
}

/* 「恢复默认」是破坏性次操作：用 danger 描边提示，但保持描边不铺实色 */
.u-btn-ghost.set-reset {
  border-color: var(--danger);
  color: var(--danger);
}

.set-note {
  margin-top: var(--sp-3);
  text-align: center;
  font-size: var(--fs-xs);
  color: var(--ink-4);
  line-height: 1.6;
}
