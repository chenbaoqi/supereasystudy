/* 游戏页样式（§15：先闭环） */
.hint {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
}

.ready {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
}

.rules {
  color: #999999;
  font-size: 26rpx;
}

.start {
  margin-top: 48rpx;
  width: 60%;
}

.hud {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  font-size: 30rpx;
}

.combo {
  color: #07c160;
  font-weight: 600;
}

.board {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 30rpx;
}

.exit {
  margin: 40rpx 30rpx;
}
