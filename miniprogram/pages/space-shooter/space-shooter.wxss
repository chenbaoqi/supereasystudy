.hint{ padding:120rpx 0; text-align:center; color:#999; font-size:28rpx; }
.ready{ display:flex; flex-direction:column; align-items:center; padding-top:160rpx; gap:24rpx; background:#1a1a2e; min-height:100vh; color:#e0e0e0; }
.ready .title{ font-size:44rpx; font-weight:600; color:#00ff88; }
.ready .rules{ color:#aaa; font-size:26rpx; }
.diff{ display:flex; align-items:center; gap:12rpx; margin-top:12rpx; }
.diff-label{ font-size:26rpx; }
.diff-btn{ margin:0; }
.diff-btn.active{ background:#00ff88; color:#1a1a2e; }
.start{ margin-top:48rpx; width:60%; }
.game-canvas{ width:750rpx; height:1040rpx; display:block; background:#1a1a2e; }
.input-bar{ text-align:center; font-size:36rpx; font-weight:600; padding:16rpx 0; letter-spacing:4rpx; background:#0f3460; color:#00ff88; }
.cursor{ animation:blink 0.8s infinite; }
@keyframes blink{ 50%{ opacity:0; } }
