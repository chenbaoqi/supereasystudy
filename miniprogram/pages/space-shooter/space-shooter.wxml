<!-- 小蜜蜂（射击打字游戏）
     UI v1.1（2026-09-14）：这是全站**唯一保留深色主题**的页面，属于有意例外 ——
     中文方块要在深色太空背景上才看得清，刷成浅底游戏就没法玩了。
     深色色值不硬编码，走 tokens.wxss 的 --game-* 一组。
     准备页/空态/得分条仍走浅色通用组件（那时屏幕上还没有游戏画面）。 -->
<view wx:if="{{poolEmpty}}" class="u-empty">
  <view class="u-empty-icon">🐝</view>
  <view class="u-empty-text">本章节知识点不足</view>
  <view class="u-empty-sub">换一个章节或学段再来看看</view>
</view>

<block wx:elif="{{status === 'READY'}}">
  <view class="ss-ready">
    <view class="ss-title">小蜜蜂</view>
    <view class="ss-rules">键盘敲英文，射击飘落的中文方块</view>
    <view class="ss-diff">
      <text class="ss-diff-label">难度：</text>
      <button
        wx:for="{{['easy','medium','hard']}}"
        wx:key="*this"
        class="u-btn u-btn-sm ss-diff-btn {{difficulty === item ? 'active' : ''}}"
        data-level="{{item}}"
        bindtap="onSetDifficulty" hover-class="u-tap-flat" hover-stay-time="60"
      >
        {{item === 'easy' ? '初级' : item === 'medium' ? '中级' : '高级'}}
      </button>
    </view>
    <view class="ss-actions">
      <button class="u-btn u-btn-primary u-btn-block" bindtap="onStart" hover-class="u-tap" hover-stay-time="60">开始游戏</button>
    </view>
  </view>
</block>

<block wx:else>
  <view class="g-hud">
    <text class="g-hud-score">得分 {{score}}</text>
    <text wx:if="{{streak >= 2}}" class="g-combo">Combo x{{streak}}</text>
  </view>

  <view class="ss-controls">
    <button class="ss-ctrl {{musicOn ? 'on' : ''}}" bindtap="onToggleMusic" hover-class="u-tap" hover-stay-time="60">
      {{musicOn ? '音乐' : '静音'}}
    </button>
    <button class="ss-ctrl {{pronounceOn ? 'on' : ''}}" bindtap="onTogglePronounce" hover-class="u-tap" hover-stay-time="60">
      {{pronounceOn ? '读音' : '静读'}}
    </button>
    <button wx:if="{{!paused}}" class="ss-ctrl" bindtap="onPauseGame" hover-class="u-tap" hover-stay-time="60">暂停</button>
    <button wx:else class="ss-ctrl" bindtap="onResume" hover-class="u-tap" hover-stay-time="60">继续</button>
  </view>

  <canvas type="2d" id="gameCanvas" class="ss-canvas" />

  <view class="ss-input-bar">{{inputText}}<text class="ss-cursor">|</text></view>

  <app-keyboard
    disabled="{{status !== 'PLAYING'}}"
    bind:keypress="onKeyPress"
    bind:backspace="onBackspace"
  />
</block>
