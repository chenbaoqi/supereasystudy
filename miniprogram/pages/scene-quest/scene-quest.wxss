/* 情景闯关 · 场景列表页
   只补布局与间距，颜色一律走 styles/tokens.wxss 的变量。 */
.sq-page {
  padding-bottom: var(--sp-4);
}

.sq-subject {
  margin: var(--sp-4) var(--gutter) 0;
  font-size: var(--fs-sm);
  color: var(--ink-2);
}

.sq-row {
  align-items: center;
}

/* 「4 问」是次要信息，跟年级 chip 并排时不能被挤掉：给左边距 + 不换行 */
.sq-count {
  margin-left: var(--sp-2);
  font-size: var(--fs-xs);
  color: var(--ink-3);
  white-space: nowrap;
}

/* 说明条：讲清「筛过」这件事，别让孩子以为题就这么点 */
.sq-hint {
  margin: var(--sp-4) var(--gutter) 0;
  padding: var(--sp-3);
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-subtle);
  font-size: var(--fs-sm);
  color: var(--ink-2);
}
