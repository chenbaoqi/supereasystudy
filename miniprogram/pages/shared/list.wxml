<!-- 列表页共享模板（DRY：learning-path / textbook / semester 三页复用）。
     UI v1.1 迁移（2026-09-14）：改用 styles/components.wxss 的 u-* 类，色值全部走 tokens。
     title / icon 为可选入参：传了就在列表上方显示分区标题与行首图标——
     「选择教材 / 选择册次」是 ADR-011 定的最顶层入口，不能是个没有标题的裸列表。 -->
<template name="list">
  <view wx:if="{{loading}}" class="u-empty">
    <text class="u-empty-text">加载中…</text>
  </view>
  <view wx:elif="{{loadFailed}}" class="u-empty">
    <text class="u-empty-icon">📡</text>
    <text class="u-empty-text">加载失败，请检查网络</text>
    <button class="u-btn u-btn-primary u-btn-sm" bindtap="onRetry" hover-class="u-tap" hover-stay-time="60">重试</button>
  </view>
  <view wx:elif="{{items.length === 0}}" class="u-empty">
    <text class="u-empty-icon">📭</text>
    <text class="u-empty-text">暂无数据</text>
  </view>
  <block wx:else>
    <view wx:if="{{title}}" class="u-section">
      <text class="u-section-title">{{title}}</text>
    </view>
    <view class="u-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="u-row"
        data-id="{{item.id}}"
        data-open="{{item.open}}"
        bindtap="onTapItem" hover-class="u-tap-flat" hover-stay-time="60"
      >
        <view wx:if="{{icon}}" class="u-row-icon">{{icon}}</view>
        <view class="u-row-body">
          <view class="u-row-title">{{item.title}}</view>
        </view>
        <view class="u-row-extra">
          <text wx:if="{{!item.open}}" class="u-chip u-chip-muted">敬请期待</text>
          <view class="u-arrow"></view>
        </view>
      </view>
    </view>
  </block>
</template>
