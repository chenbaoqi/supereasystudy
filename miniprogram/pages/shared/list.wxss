/* 列表页共享样式（§15：UI 从简，正式规范以 Specification 第 12 章为准） */
.hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 30rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.tag {
  color: #999999;
  font-size: 24rpx;
}

/* 列表项右侧操作区（状态标签 + 游戏入口按钮，章节页/首页共用） */
.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.game-entry {
  margin: 0;
  font-size: 24rpx;
  line-height: 2;
}
