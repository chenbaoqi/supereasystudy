/* 个人形象页：头像网格 + 一行昵称输入。 */
.pf-preview {
  margin: 0 var(--gutter) var(--sp-3);
  font-size: var(--fs-sm);
  color: var(--ink-3);
  text-align: center;
}

.pf-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 var(--gutter);
}

.pf-item {
  width: 25%;
  padding: var(--sp-3) 0;
  font-size: 56rpx;
  line-height: 1.2;
  text-align: center;
  border-radius: var(--radius-card);
}

/* 选中的：加底色而不是换图标，一眼看出「我选的是这个」 */
.pf-item-on {
  background: var(--brand-50);
}

.pf-input {
  flex: 1;
  padding: var(--sp-2) 0;
  font-size: var(--fs-md);
  color: var(--ink-1);
}

.pf-save {
  margin: var(--sp-4) var(--gutter) 0;
}
