/* 学习详情页样式（§15：UI 从简；卡片样式与 review-detail 共享，见 shared/card.wxss） */
@import '../shared/card.wxss';

.hint {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
}

.pos {
  color: #999999;
}

.translation {
  color: #666666;
}

/* 语法讲解区块（Chapter 12）：灰底卡片与例句区分 */
.explanation {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333333;
}

.actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}
