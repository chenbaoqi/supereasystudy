<view wx:if="{{loading}}" class="hint">加载中…</view>
<view wx:elif="{{!current}}" class="hint">暂无知识点</view>
<view wx:else class="card">
  <view class="word-row">
    <text class="word">{{current.word}}</text>
    <text class="ipa" wx:if="{{current.ipa}}">/{{current.ipa}}/</text>
  </view>
  <view class="line" wx:if="{{current.partOfSpeech}}">
    <text class="pos">{{current.partOfSpeech}}</text>
  </view>
  <view class="line meaning">{{current.meaning}}</view>
  <!-- 语法讲解区块（Chapter 12：type=grammar 时展示 explanation） -->
  <view class="explanation" wx:if="{{current.explanation}}">{{current.explanation}}</view>
  <view class="line" wx:if="{{current.example}}">{{current.example}}</view>
  <view class="line translation" wx:if="{{current.translation}}">{{current.translation}}</view>

  <view class="progress">{{index + 1}} / {{total}}</view>

  <view class="actions">
    <button size="mini" bindtap="onToggleFavorite">{{isFavorite ? '★ 已收藏' : '☆ 收藏'}}</button>
    <!-- 发音常态化（TTS）；语法点不朗读（Owner 2026-07-30：游戏/朗读只针对记单词） -->
    <button wx:if="{{current.type !== 'grammar'}}" size="mini" bindtap="onPlayWord">
      🔊 发音
    </button>
  </view>

  <view class="nav">
    <button bindtap="onPrevious" disabled="{{isFirst}}">上一条</button>
    <button wx:if="{{!isLast}}" type="primary" bindtap="onNext">下一条</button>
    <button wx:else type="primary" bindtap="onFinish">完成学习</button>
  </view>
</view>
