/* 学习统计页 UI v1.1（2026-09-14）
   原 .card / .grid 与 pages/shared/card.wxss 同名（后者已删），这里改用本地 st- 前缀，
   2 列布局直接复用 components.wxss 的 .u-grid。 */
.st-grid {
  margin-top: var(--sp-4);
}

.st-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-5) var(--sp-3);
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.st-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 4rpx;
}

.st-num {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--brand-700);
  line-height: 1.2;
}

.st-label {
  font-size: var(--fs-sm);
  color: var(--ink-2);
}
