<!-- 学习统计页
     UI v1.1（2026-09-14）：2×2 卡片走 u-grid，数字用 --brand-700（深一档）。
     注意配色原则：淡化的是**大面积底色**，数字是要被读取的信息，不能跟着一起变淡。 -->
<view wx:if="{{loading}}" class="u-empty">
  <view class="u-empty-icon">⏳</view>
  <view class="u-empty-text">加载中…</view>
</view>

<view wx:elif="{{loadFailed}}" class="u-empty">
  <view class="u-empty-icon">📡</view>
  <view class="u-empty-text">加载失败，请检查网络</view>
  <button class="u-btn u-btn-primary" bindtap="onRetry" hover-class="u-tap" hover-stay-time="60">重试</button>
</view>

<view wx:else class="u-grid st-grid">
  <view class="st-card">
    <text class="st-icon">🔁</text>
    <text class="st-num">{{stats.todayReviewedKnowledge}}</text>
    <text class="st-label">今日复习知识点</text>
  </view>
  <view class="st-card">
    <text class="st-icon">📘</text>
    <text class="st-num">{{stats.todayStudiedChapters}}</text>
    <text class="st-label">今日学习章节</text>
  </view>
  <view class="st-card">
    <text class="st-icon">📚</text>
    <text class="st-num">{{stats.totalKnowledge}}</text>
    <text class="st-label">累计知识点</text>
  </view>
  <view class="st-card">
    <text class="st-icon">🔥</text>
    <text class="st-num">{{stats.streakDays}}</text>
    <text class="st-label">连续学习（天）</text>
  </view>
</view>
