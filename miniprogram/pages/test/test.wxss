/* 测试页样式（§15：UI 从简） */
.hint {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.hint-sub {
  font-size: 24rpx;
  color: #bbbbbb;
}

.container {
  padding: 40rpx 30rpx;
}

.progress {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}

.word {
  margin: 48rpx 0;
  text-align: center;
  font-size: 48rpx;
  font-weight: 600;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.option.correct {
  background: #07c160;
  color: #ffffff;
}

.option.wrong {
  background: #fa5151;
  color: #ffffff;
}

/* 题型标签（Chapter 13 Section 化） */
.kind-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #e8f9f0;
  color: #07c160;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.kind-badge.listening {
  background: #e7f0fd;
  color: #2f6fdd;
}

.kind-badge.grammar {
  background: #fdf0e7;
  color: #dd7a2f;
}

.speaker-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 48rpx 0;
  gap: 12rpx;
}

.speaker {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.speaker-hint {
  color: #999999;
  font-size: 24rpx;
}
