/* 测试页 UI v1.1（2026-09-14）
   选项 / 喇叭 / 空态 / 按钮全部来自 styles/components.wxss，
   这里只留本页独有的：进度条、题干卡片、底部操作行。 */
.ts-page {
  padding-bottom: calc(var(--sp-6) + env(safe-area-inset-bottom));
}

/* ----------------------------------------------------------- 头部（题型/进度） */
.ts-head {
  padding: var(--sp-4) var(--sp-5);
}

.ts-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
}

.ts-progress {
  font-size: var(--fs-sm);
  color: var(--ink-2);
}

.ts-bar {
  margin-top: var(--sp-3);
  height: 8rpx;
  border-radius: var(--r-pill);
  background: var(--state-todo-bg);
  overflow: hidden;
}

.ts-bar-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--brand-400);
  transition: width 0.25s;
}

/* ------------------------------------------------------------------- 题干 */
.ts-stem {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-5) var(--sp-4);
}

.ts-prompt {
  font-size: var(--fs-2xl);
  font-weight: 600;
  color: var(--ink-1);
  line-height: 1.3;
  text-align: center;
  word-break: break-all;
}

/* ------------------------------------------------- 题目配图（B-7 闭环） */
/* 图要压在题干和选项之间：先看题 → 再看图 → 再选，顺序不能反 */
.ts-visual {
  margin: 0 var(--gutter) var(--sp-4);
  padding: var(--sp-3) var(--sp-2);
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

/* ------------------------------------------------- 答错后的操作行（UI v1.1） */
/* 「问 AI」是次操作走描边；「下一题」是主操作走实色 */
.answer-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin: 0 var(--gutter);
}

.answer-ai,
.answer-next {
  flex: 1;
  padding: 0 var(--sp-4);
}
