.kb{ padding:10rpx 4rpx; background:#1a1a2e; user-select:none; }
.kb-row{ display:flex; justify-content:center; gap:6rpx; margin-bottom:8rpx; }
.kb-key{ width:64rpx; height:72rpx; background:#16213e; color:#e0e0e0; border-radius:6rpx; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:500; border:none; padding:0; line-height:1; }
.kb-key:active{ background:#0f3460; color:#00ff88; }
.kb-wide{ width:80rpx; }
.kb-space{ width:420rpx; }
