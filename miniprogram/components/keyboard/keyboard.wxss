.kb {
  padding: 12rpx 6rpx;
  background: #d1d5db;
}

.kb-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.kb-key {
  width: 62rpx;
  height: 74rpx;
  background: #ffffff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.kb-key:active {
  background: #c8cad0;
}

.kb-wide {
  width: 96rpx;
}

.kb-space {
  width: 300rpx;
}

.kb-actions {
  gap: 20rpx;
}
